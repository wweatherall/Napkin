#!/bin/sh
# Tracked hook (git -c core.hooksPath=.githooks commit ...): keeps the decision log's two files tidy (P23:
# sorted by ID, archival rows moved to the archive, generated columns rebuilt) whenever either is in a commit
# (tools/sort_decision_log.py), so nobody has to remember to.
cd "$(git rev-parse --show-toplevel)" || exit 1
if git diff --cached --name-only | grep -q "^03_Past_Decisions/rulings/\|^03_Past_Decisions/decision-log\.md$\|^03_Past_Decisions/decision-archive\.md$"; then
  if [ "$(git branch --show-current)" = main ]; then
    python3 tools/sort_decision_log.py --move-process || exit 1
  fi
  python3 02_Habits/WHEN_THE_LOG_IS_COMMITTED_TIDY_IT.py || exit 1
  git add 03_Past_Decisions/decision-log.md
  [ -f 03_Past_Decisions/decision-archive.md ] && git add 03_Past_Decisions/decision-archive.md
  [ -d 03_Past_Decisions/rulings ] && git add 03_Past_Decisions/rulings
  python3 02_Habits/WHEN_THE_LOG_IS_COMMITTED_TIDY_IT.py --check || exit 1
fi
# The handoff's open list and Archived summary are built by tools/handoff.py tidy: rebuild and stage them.
if git diff --cached --name-only | grep -q "^docs/handoff/\|^docs/agent-handoff\.md$\|^docs/handoff-archive\.md$"; then
  python3 tools/handoff.py check --staged || exit 1
  python3 tools/handoff.py tidy >/dev/null || exit 1
  git add docs/agent-handoff.md
  python3 tools/handoff.py tidy --check || exit 1
fi
# BOARD.md's job table is built from docs/handoff/ and the job queue (P24, tools/job.py): rebuild it on main only
# (workers don't edit the board, so their branches never carry a rebuilt table to conflict with main's).
if [ "$(git branch --show-current)" = main ] && grep -q "job table: built by tools/job.py" BOARD.md 2>/dev/null &&
   git diff --cached --name-only | grep -q "^docs/handoff/\|^BOARD.md$"; then
  python3 tools/job.py board >/dev/null || exit 1
  git add BOARD.md
  # job.py board also moves Work list statuses (H156: On the board / Open) and their indexes: stage those too.
  git add 03_Past_Decisions
fi
# ARCHITECTURE.md's module map is built from each file's header (tools/architecture_map.py): rebuild and stage it.
if grep -q "module map: built by tools/architecture_map.py" ARCHITECTURE.md 2>/dev/null &&
   git diff --cached --name-only | grep -qE "^(viewport|worker|tools)/.*\.(gd|py|sh)$|^ARCHITECTURE\.md$"; then
  python3 tools/architecture_map.py || exit 1
  git add ARCHITECTURE.md
  python3 tools/architecture_map.py --check || exit 1
fi
# docs/dependency-map.md is built from imports, preloads, and main.gd forwarders (tools/dependency_map.py).
if grep -q "dependency map: built by tools/dependency_map.py" docs/dependency-map.md 2>/dev/null &&
   git diff --cached --name-only | grep -qE "^(viewport|worker|tools)/.*\.(gd|py)$|^docs/dependency-map\.md$"; then
  python3 tools/dependency_map.py || exit 1
  git add docs/dependency-map.md
  python3 tools/dependency_map.py --check || exit 1
fi
# docs/protocol.md's message table is built from worker/serve.py and worker/length_input.py (tools/protocol_map.py).
if grep -q "protocol map: built by tools/protocol_map.py" docs/protocol.md 2>/dev/null &&
   git diff --cached --name-only | grep -qE "^worker/(serve|length_input)\.py$|^docs/protocol\.md$"; then
  python3 tools/protocol_map.py || exit 1
  git add docs/protocol.md
  python3 tools/protocol_map.py --check || exit 1
fi
# comitatus/06_To-dos fills itself from main (T134): one file per thing waiting on William or the integrator.
# Fail-open: a to-do file is never a reason to refuse a commit.
if [ "$(git branch --show-current)" = main ]; then
  python3 02_Habits/WHEN_MAIN_CHANGES_FILL_THE_TO_DOS.py --quiet || true
fi
