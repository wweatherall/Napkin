#!/bin/sh
# Tracked hook (git -c core.hooksPath=.githooks commit ...): keeps the decision log's two files tidy (P23:
# sorted by ID, archival rows moved to the archive, generated columns rebuilt) whenever either is in a commit
# (tools/sort_decision_log.py), so nobody has to remember to.
cd "$(git rev-parse --show-toplevel)" || exit 1
if git diff --cached --name-only | grep -qx "03_Past_Decisions/decision-log.md\|03_Past_Decisions/decision-archive.md"; then
  python3 tools/sort_decision_log.py || exit 1
  git add 03_Past_Decisions/decision-log.md
  [ -f 03_Past_Decisions/decision-archive.md ] && git add 03_Past_Decisions/decision-archive.md
  python3 tools/sort_decision_log.py --check || exit 1
fi
# The handoff's open list is built from docs/handoff/ (T77): rebuild it and stage it, so a hand edit can't disagree.
if git diff --cached --name-only | grep -q "^docs/handoff/\|^docs/agent-handoff.md$"; then
  python3 tools/handoff.py check --staged || exit 1
  python3 tools/handoff.py list >/dev/null || exit 1
  git add docs/agent-handoff.md
  python3 tools/handoff.py list --check || exit 1
fi
# BOARD.md's job table is built from docs/handoff/ and the job queue (P24, tools/job.py): rebuild it on main only
# (workers don't edit the board, so their branches never carry a rebuilt table to conflict with main's).
if [ "$(git branch --show-current)" = main ] && grep -q "job table: built by tools/job.py" BOARD.md 2>/dev/null &&
   git diff --cached --name-only | grep -q "^docs/handoff/\|^BOARD.md$"; then
  python3 tools/job.py board >/dev/null || exit 1
  git add BOARD.md
fi
