extends RefCounted
## T58: copy, amend, enter and detach a whole assembly with the real tools.
const Main := preload("res://main.gd")
const Harness := preload("res://tests/harness.gd")
var harness: Harness
var m: Main:
	get: return harness.m


func run() -> void:
	var base := harness._plank(1, Vector3.ZERO, Vector3(100, 50, 18)) + harness._plank(2, Vector3(0, 100, 0), Vector3(100, 50, 18))
	base.append({"id": "as1", "type": "make_assembly", "targets": ["b1", "b2"], "new_id": "a1"})
	await harness._fresh("assembly_row", base)
	await harness._view(Vector3(300, 75, 0), -25, -50, 2.4)
	m.set_tool("move")
	await harness._grab(Vector3(50, 25, 18))
	await harness._key(KEY_ALT)
	await harness._key(KEY_RIGHT)
	await harness._drag_to(Vector3(200, 25, 18), 6)
	await harness._type("200\n")
	await harness._wait_wave()
	await harness._type("3x\n")
	await harness._wait_wave()
	var made: Array = m.ops.back().get("new_ids", [])
	harness._ok("3x copies a two-board assembly three times in one op", made.size() == 6 and m.ops.size() == base.size() + 1, m.ops.back())
	if made.size() != 6: return
	harness._ok("each copy has its own assembly", m.body_assembly[made[0]] == m.body_assembly[made[3]] and m.body_assembly[made[0]] != m.body_assembly[made[1]], m.body_assembly)
	harness._ok("outside, a board stands for the entire assembly row", m.sel.unit_of(made[0])["bodies"].size() == 8, m.sel.unit_of(made[0]))
	await harness._type("/3\n")
	await harness._wait_wave()
	made = m.ops.back()["new_ids"]
	harness._ok("/3 distributes whole assemblies across the span", absf(harness._bbox(made[0])[0] - 200.0 / 3.0) < 0.01 and absf(harness._bbox(made[3])[0] - 200.0 / 3.0) < 0.01, [harness._bbox(made[0]), harness._bbox(made[3])])
	await harness._type("600\n")
	await harness._wait_wave()
	made = m.ops.back()["new_ids"]
	harness._ok("retyping the span adjusts both boards of every assembly", harness._bbox(made[0])[0] == 200.0 and harness._bbox(made[3])[0] == 200.0, [harness._bbox(made[0]), harness._bbox(made[3])])
	m.set_tool("select")
	m.set_tool("move")
	await harness._grab(Vector3(250, 25, 18))
	await harness._key(KEY_UP)
	await harness._drag_to(Vector3(250, 25, 60), 6)
	await harness._type("25\n")
	await harness._wait_wave()
	harness._ok("outside, moving one assembly moves the whole row", harness._bodies().values().all(func(b): return b["world_bbox"][2] == 25.0), m.ops.back())
	m.undo()
	await harness._wait_wave()
	m.set_tool("select")
	await harness._double_click_at(Vector3(250, 25, 18))
	harness._ok("double-click enters the row", m.context.begins_with("row:"), m.context)
	harness._ok("inside a row, a whole assembly is one member", m.sel.unit_of(made[0])["kind"] == "assembly" and m.sel.unit_of(made[0])["bodies"].size() == 2, m.sel.unit_of(made[0]))
	await harness._double_click_at(Vector3(250, 25, 18))
	harness._ok("entering again enters that assembly", m.context == "assembly:" + m.body_assembly[made[0]], m.context)
	await harness._key(KEY_ESCAPE)
	harness._ok("Esc returns from the assembly to its row", m.context.begins_with("row:"), m.context)
	m.set_tool("move")
	await harness._grab(Vector3(250, 25, 18))
	await harness._key(KEY_UP)
	await harness._drag_to(Vector3(250, 25, 60), 6)
	await harness._type("50\n")
	await harness._wait_wave()
	harness._ok("moving a row member detaches and moves its whole assembly", harness._bbox(made[0])[2] == 50.0 and harness._bbox(made[3])[2] == 50.0 and m.body_array.get(made[0], "") == "" and m.body_array.get(made[3], "") == "", m.ops.back())
	m.undo()
	await harness._wait_wave()
	harness._ok("undo restores the member and its spacing links", harness._bbox(made[0])[2] == 0.0 and m.body_array.get(made[0], "") != "", harness._bbox(made[0]))
	m.undo()
	await harness._wait_wave()
	harness._ok("one undo removes all copied assemblies", harness._bodies().size() == 2 and m.ops.size() == base.size(), m.ops)
